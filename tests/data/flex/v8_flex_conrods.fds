%
%---------------- Gear Constraint ------------------------
%
%
%---------------- Motion Constraint ------------------------
%
%
%---------------- Forces ------------------------
%
Force GenericTorque
	 ForceID = 1
	 BodyIDs = 1,0
	 AxisType = SpaceFixed
	 Axis = 1.000000,0.000000,0.000000
	 TorqueExpression = -PARVAL[damp]*MEAVAL[omega_KW]
EndForce
%
Force GenericTorque
	 ForceID = 2
	 BodyIDs = 1,0
	 AxisType = SpaceFixed
	 Axis = 1.000000,0.000000,0.000000
	 TorqueExpression = STEP[SIMTIME[],1.5,0.0,2.5,2.0e5,cosine]-STEP[SIMTIME[],3.0,0.0,4.0,2.0e5,cosine]+STEP[SIMTIME[],0.0,0.0,0.1,2.0e4,cosine]
EndForce
%
%
%---------------- Data Object ------------------------
%
DataObject Parameter
	 Label  = damp
	 VisualizationID = 1
	 InitialValue = 500.000000
EndDataObject
%
%
%---------------- Measures ------------------------
%
Measure Rotational
	 MeasureName = omega_KW
	 MeasureID = 1
	 BodyIDs = 1,0
	 MeasureCoordinate = AngleVel
	 MeasureVec = 0.000000,1.000000,0.000000
	 MeasurePlaneVec1 = 0.000000,1.000000,0.000000
	 MeasurePlaneVec2 = 0.000000,0.000000,1.000000
	 UseInitialValueAsOffset = yes
EndMeasure
%
%---------------- Solver ------------------------
%
Simulation Dynamic
	 SimulationTimeEnd = 0.05
	 OutputTimeBegin = 0.000000
	 OutputTimeStepSize = 1.000000e-03
	 isExactOutputTimeEnforced = yes
	 WriteConstraintForceResultFile = no
	 WriteForceResultFile = no
	 WriteVelocityResultFile = no
	 WriteStateResultFile = yes
	 WriteAccelerationResultFile = no
	 WriteExtConstraintLagrangeResultFile = no
	 WriteMeasureResultFile = yes
EndSimulation
%
Solver HHT
	 Alpha = -0.300000
	 MaxNumberOfInnerIterations = 10, 10
	 GlobalErrorTolerance = 1.000000e-05
	 SolverMinTimeStep = 1.000000e-14
	 SolverMaxTimeStep = 5.000000e-04
	 ModifyNewmark = no
	 MaxNumOfTimeStepsUsingSameFactorizedJacobian = 0
	 UsePardisoScalingAndMatching = no
	 DebugLevel = 0
	 DebugTimeBegin = 0.000000
	 DebugTimeEnd = 1.000000
EndSolver
%
